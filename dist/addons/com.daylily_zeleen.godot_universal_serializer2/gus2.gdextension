[infomation]
name = "GUS - Godot Universal Serializer 2"
version = "v2.3.0-dev"
decription = "A DragonBones plugin for Godot."
author = "忘忧の (Daylily Zeleen)"
email = "daylily-zeleen@foxmail.com"
support_link = "https://afdian.com/a/Daylily-Zeleen"
repo = "https://github.com/Daylily-Zeleen/GUS-Godot-Universal-Serializer-2.0"
others = "诚接Godot游戏开发，欢迎邮件联系。/ Receive game development outsourcing, welcome to contact by email."

[configuration]

entry_symbol = "gus_library_init"
compatibility_minimum = 4.3

[libraries]

macos = "bin/libgus2.macos.framework"
windows.x86_32 = "bin/libgus2.windows.x86_32.dll"
windows.x86_64 = "bin/libgus2.windows.x86_64.dll"
linux.x86_64 = "bin/libgus2.linux.x86_64.so"
android.x86_64 = "bin/libgus2.android.x86_64.so"
android.arm64 = "bin/libgus2.android.arm64.so"
ios = "bin/libgus2.ios.xcframework"
web.threads.wasm32 = "bin/libgus2.web.wasm32.wasm"
web.wasm32 = "bin/libgus2.web.wasm32.nothreads.wasm"

[dependencies]

ios = {
	"bin/libgodot-cpp.ios.xcframework": ""
}
